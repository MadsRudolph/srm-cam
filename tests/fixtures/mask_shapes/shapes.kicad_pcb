(kicad_pcb (version 20240108) (generator "pcbnew") (generator_version "8.0")
  (general (thickness 1.6) (legacy_teardrops no))
  (paper "A4")
  (layers (0 "F.Cu" signal) (31 "B.Cu" signal) (36 "B.SilkS" user "B.Silkscreen") (37 "F.SilkS" user "F.Silkscreen") (38 "B.Mask" user) (39 "F.Mask" user) (44 "Edge.Cuts" user) (49 "F.Fab" user))
  (setup (pad_to_mask_clearance 0) (allow_soldermask_bridges_in_footprints no))
  (net 0 "")
  (footprint "t:rect" (layer "B.Cu") (at 112 112) (attr smd)
    (pad "1" smd rect (at 0 0 180) (size 2 3) (layers "B.Cu" "B.Mask")))
  (footprint "t:rect30" (layer "B.Cu") (at 122 112 ) (attr smd)
    (pad "1" smd rect (at 0 0 30) (size 2 3) (layers "B.Cu" "B.Mask")))
  (footprint "t:round" (layer "B.Cu") (at 132 112) (attr smd)
    (pad "1" smd circle (at 0 0) (size 2.5 2.5) (layers "B.Cu" "B.Mask")))
  (footprint "t:oval" (layer "B.Cu") (at 142 112) (attr smd)
    (pad "1" smd oval (at 0 0) (size 3 1.6) (layers "B.Cu" "B.Mask")))
  (footprint "t:oval45" (layer "B.Cu") (at 112 122) (attr smd)
    (pad "1" smd oval (at 0 0 45) (size 3 1.6) (layers "B.Cu" "B.Mask")))
  (footprint "t:roundrect" (layer "B.Cu") (at 122 122) (attr smd)
    (pad "1" smd roundrect (at 0 0) (size 3 2) (layers "B.Cu" "B.Mask") (roundrect_rratio 0.25)))
  (footprint "t:roundrect20" (layer "B.Cu") (at 132 122) (attr smd)
    (pad "1" smd roundrect (at 0 0 20) (size 3 2) (layers "B.Cu" "B.Mask") (roundrect_rratio 0.25)))
  (footprint "t:thru" (layer "F.Cu") (at 142 122)
    (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask")))
  (footprint "t:tiny" (layer "B.Cu") (at 112 132) (attr smd)
    (pad "1" smd rect (at 0 0) (size 0.15 0.15) (layers "B.Cu" "B.Mask")))
  (footprint "t:narrow" (layer "B.Cu") (at 118 132) (attr smd)
    (pad "1" smd rect (at 0 0) (size 0.3 2) (layers "B.Cu" "B.Mask")))
  (gr_poly (pts (xy 124 128) (xy 134 128) (xy 134 134) (xy 129 134) (xy 129 131) (xy 124 131)) (stroke (width 0) (type solid)) (fill solid) (layer "B.Mask"))
  (gr_rect (start 105 105) (end 150 137) (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts"))
)
